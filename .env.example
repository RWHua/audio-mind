# DeepSeek API 配置
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 火山引擎 ASR 配置（豆包语音识别大模型）
# 获取方式: https://console.volcengine.com/speech/app → 旧版控制台 → 创建应用
# 勾选「录音文件识别大模型 → 录音文件识别大模型极速版」
# 创建后在应用详情页底部复制 APP ID 和 Access Token
VOLCENGINE_APP_ID=your_app_id_here
VOLCENGINE_ACCESS_TOKEN=your_access_token_here

# 阿里云 ASR 配置（智能语音交互）
# 获取方式: https://ram.console.aliyun.com/users → 创建 RAM 用户
# 勾选「OpenAPI 调用访问」，授权 AliyunNLSFullAccess + AliyunOSSFullAccess
ALIBABA_ACCESS_KEY_ID=your_access_key_id_here
ALIBABA_ACCESS_KEY_SECRET=your_access_key_secret_here
